//@version=6
indicator("ORCA Paper — Tenkan9 30m / VWAP + EMA200 5m preference", overlay=true)

webhookSecret = input.text_area("", "سر الربط — REEF_WEBHOOK_SECRET", confirm=true, display=display.none)
sendPaper = input.bool(false, "إرسال الشموع للاختبار الورقي فقط", confirm=true, display=display.none)

if not timeframe.isminutes or timeframe.multiplier != 30
    runtime.error("استخدم شارت نصف ساعة (30 دقيقة).")
if not chart.is_standard
    runtime.error("استخدم شموعًا عادية، وليس Heikin Ashi أو Renko.")
if syminfo.type != "stock" or syminfo.timezone != "America/New_York"
    runtime.error("هذا الاختبار مخصص للأسهم الأمريكية.")
if syminfo.session != session.regular
    runtime.error("اختر الجلسة العادية فقط، وأوقف الساعات الممتدة.")

// Tenkan-sen: nine thirty-minute bars, with no forward displacement.
tenkanHigh9 = ta.highest(high, 9)
tenkanLow9 = ta.lowest(low, 9)
tenkan9 = bar_index >= 8 ? (tenkanHigh9 + tenkanLow9) / 2.0 : na
// Preserve the existing five-minute EMA200 and HLC3 session VWAP.
// At a confirmed 30m close, lookahead_off selects the last closed 5m bar.
ema200 = request.security(syminfo.tickerid, "5", ta.ema(close, 200), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
sessionVwap = request.security(syminfo.tickerid, "5", ta.vwap(hlc3, session.isfirstbar_regular), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
previousVwap = session.isfirstbar_regular ? na : sessionVwap[1]

plot(tenkan9, "خط التحويل Tenkan-sen 9 — نصف ساعة", color=color.orange, linewidth=2)
plot(ema200, "EMA200 — 200 شمعة خمس دقائق، تفضيل فقط", color=color.blue, linewidth=2)
plot(sessionVwap, "VWAP — الجلسة العادية", color=color.purple, linewidth=2)

crossUp(float level, float before) =>
    not na(level) and not na(before) and close[1] <= before and close > level
crossDown(float level, float before) =>
    not na(level) and not na(before) and close[1] >= before and close < level

up = crossUp(tenkan9, tenkan9[1]) or crossUp(sessionVwap, previousVwap)
down = crossDown(tenkan9, tenkan9[1]) or crossDown(sessionVwap, previousVwap)
callSignal = barstate.isconfirmed and session.ismarket and up and not down
putSignal = barstate.isconfirmed and session.ismarket and down and not up
plotshape(callSignal, title="CALL ورقي", text="CALL\nورقي", style=shape.labelup, location=location.belowbar, color=color.green, textcolor=color.white, size=size.tiny)
plotshape(putSignal, title="PUT ورقي", text="PUT\nورقي", style=shape.labeldown, location=location.abovebar, color=color.red, textcolor=color.white, size=size.tiny)

escapeJson(string value) =>
    str.replace_all(str.replace_all(str.replace_all(str.replace_all(value, "\\", "\\\\"), "\"", "\\\""), "\n", "\\n"), "\r", "\\r")
numberJson(float value) =>
    na(value) ? "null" : str.tostring(value, "#.############")
levelsJson(float conversionLine, float longAverage, float vwap) =>
    "{\"tenkan9_30m\":" + numberJson(conversionLine) + ",\"ema200_5m\":" + numberJson(longAverage) + ",\"session_vwap\":" + numberJson(vwap) + "}"

secretReady = str.length(str.trim(webhookSecret)) > 0
var table setupStatus = table.new(position.top_right, 1, 3)
if barstate.islast
    status = not sendPaper ? "الإرسال الورقي معطّل" : not secretReady ? "السر فارغ — لن يتم الإرسال" : "جاهز محليًا — يلزم إنشاء تنبيه TradingView"
    table.cell(setupStatus, 0, 0, status, text_color=color.white, bgcolor=color.new(secretReady and sendPaper ? color.green : color.gray, 20))
    table.cell(setupStatus, 0, 1, "ورقي فقط — الإشارة بإغلاق نصف الساعة", text_color=color.white, bgcolor=color.new(color.gray, 20))
    contextText = na(ema200) ? "EMA200 غير متاح — لا يمنع الإشارة" : close > ema200 ? "فوق EMA200 — تفضيل CALL فقط، لا يمنع PUT" : close < ema200 ? "تحت EMA200 — تفضيل PUT فقط، لا يمنع CALL" : "السعر عند EMA200 — تفضيل محايد"
    table.cell(setupStatus, 0, 2, contextText, text_color=color.white, bgcolor=color.new(color.blue, 35))

varip int lastSentClose = na
fresh = timenow >= time_close and timenow - time_close <= 120000
hasPriorBar = not na(close[1]) and not na(time_close[1])
if barstate.isrealtime and barstate.isconfirmed and session.ismarket and sendPaper and secretReady and fresh and hasPriorBar and (na(lastSentClose) or time_close != lastSentClose)
    // Every closed 30m bar measures later stock movement, not option profit.
    body = "{\"secret\":\"" + escapeJson(webhookSecret) + "\",\"ticker\":\"" + syminfo.ticker + "\",\"signal_type\":\"ORCA_PAPER_CROSS_V5\",\"timeframe\":\"30\",\"bar_closed\":true,\"regular_session\":true,\"tenkan_period\":9,\"tenkan_timeframe\":\"30\",\"tenkan_method\":\"HIGH_LOW_MIDPOINT\",\"ema200_period\":200,\"ema200_timeframe\":\"5\",\"vwap_anchor\":\"US_REGULAR_SESSION\",\"vwap_timeframe\":\"5\",\"bar_time_ms\":" + str.tostring(time) + ",\"bar_close_time_ms\":" + str.tostring(time_close) + ",\"previous_bar_close_time_ms\":" + str.tostring(time_close[1]) + ",\"previous_close\":" + numberJson(close[1]) + ",\"close\":" + numberJson(close) + ",\"previous_levels\":" + levelsJson(tenkan9[1], ema200[1], previousVwap) + ",\"levels\":" + levelsJson(tenkan9, ema200, sessionVwap) + "}"
    alert(body, alert.freq_once_per_bar_close)
    lastSentClose := time_close
